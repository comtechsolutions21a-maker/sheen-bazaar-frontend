# =========================================================
# Sheen Bazaar — Frontend Environment Variables
# Copy this file to .env (for local dev) or set on Netlify dashboard
# for production. NEVER commit your .env to version control.
# =========================================================

# For local development: leave as-is (Vite dev server proxies /api to :5000)
# For production (Netlify → Render): set this to your Render backend URL
# Example: VITE_API_URL=https://sheen-bazaar-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# =========================================================
# Social login — only the PUBLIC ids go here (never secrets).
# Leave blank to hide that login button.
# =========================================================

# Same Google OAuth Client ID as the backend's GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=

# Same Facebook App ID as the backend's FACEBOOK_APP_ID
VITE_FACEBOOK_APP_ID=
